# =========================
# Runtime Profile
# =========================
# Options: cpu_local, gpu_adapter
RUNTIME_MODE=cpu_local

# Optional explicit device override (cpu, cuda)
# DEVICE=cpu

# =========================
# Model / Generation
# =========================
# Optional explicit model override
# MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0

MAX_TOKENS=512
TEMPERATURE=0.7
GENERATION_MAX_TIME=45

# Hugging Face caching / offline controls
# HF_CACHE_DIR=C:/Users/YourUser/.cache/huggingface
HF_LOCAL_FILES_ONLY=false

# =========================
# Groq (optional inference backend)
# =========================
USE_GROQ=true
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key

# =========================
# Hugging Face auth
# =========================
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================
# API / UI
# =========================
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit UI can point to backend URL
API_URL=http://127.0.0.1:8000

# =========================
# Logging
# =========================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =========================
# MLflow + DagsHub (optional)
# =========================
DAGSHUB_USER=your_username
DAGSHUB_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MLFLOW_TRACKING_URI=https://dagshub.com/YOUR_USERNAME/AI-Banking-Assistant.mlflow
MLFLOW_TRACKING_USERNAME=your_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token
MLFLOW_EXPERIMENT_NAME=AI-Banking-Assistant